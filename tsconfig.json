{
    "compilerOptions": {
          "strict": true,
          "module": "commonjs",
          "moduleResolution": "node",
          "target": "es2019",
          "lib": ["es2019", "es2020", "es2022.error"],
          "removeComments": true,
          "useUnknownInCatchVariables": false,
          "forceConsistentCasingInFileNames": true,
          "noImplicitAny": true,
          "sourceMap": true,
          "declaration": true,
          "outDir": "./dist",
          "skipLibCheck": true,
          "resolveJsonModule": true
    },
    "include": ["credentials/**/*.ts", "nodes/**/*.ts"],
    "exclude": ["node_modules/**", "dist/**"]
}
